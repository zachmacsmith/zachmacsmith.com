---
import { getCollection } from 'astro:content';
import { copy } from '../data/copy';

const currentPath = Astro.url.pathname;
const hasNotes = (await getCollection('notes')).length > 0;

const links = [
  { href: '/projects', label: copy.projects.heading },
  { href: '/writing/essays', label: copy.essays.heading },
  ...(hasNotes ? [{ href: '/writing/notes', label: copy.notes.heading }] : []),
];
---

<header class="col site-header">
  <a href="/" class="site-name">{copy.siteName}</a>
  <nav class="site-nav">
    {links.map((link) => (
      <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    <a href="https://github.com/zachmacsmith" target="_blank" rel="noopener noreferrer">GitHub</a>
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
      <span id="theme-label">auto</span>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-label');
  const html = document.documentElement;

  function getSystemDark() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function applyTheme(stored: string | null) {
    if (stored === 'dark') {
      html.setAttribute('data-theme', 'dark');
      if (label) label.textContent = 'dark';
    } else if (stored === 'light') {
      html.setAttribute('data-theme', 'light');
      if (label) label.textContent = 'light';
    } else {
      html.removeAttribute('data-theme');
      if (label) label.textContent = 'auto';
    }
  }

  // Init from storage
  applyTheme(localStorage.getItem('theme'));

  toggle?.addEventListener('click', () => {
    const stored = localStorage.getItem('theme');
    const systemDark = getSystemDark();

    if (!stored) {
      // Auto → force opposite of system
      const next = systemDark ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    } else if (stored === 'dark') {
      // Dark → light
      localStorage.setItem('theme', 'light');
      applyTheme('light');
    } else {
      // Light → back to auto
      localStorage.removeItem('theme');
      applyTheme(null);
    }
  });
</script>
