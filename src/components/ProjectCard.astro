---
interface Props {
  title: string;
  description: string;
  status: 'active' | 'complete' | 'paused';
  tags: string[];
  github?: string;
  pypi?: string;
  paper?: string;
  demo?: string;
  blog?: string;
  image?: string;
  link?: string;
}

const { title, description, status, tags, github, pypi, paper, demo, blog, image, link } = Astro.props;
---

<div
  class="project-card flex flex-col"
  data-has-image={image ? "" : undefined}
  style="position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; overflow: hidden;"
>
  {image && (
    <img
      src={image}
      alt={title}
      style="width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 4px 4px 0 0; display: block;"
    />
  )}

  {link && (
    <a
      href={link}
      aria-label={title}
      style="position: absolute; inset: 0; z-index: 0;"
      target={link.startsWith('http') ? '_blank' : undefined}
      rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
    />
  )}

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-baseline justify-between gap-3 mb-2">
      <h2 class="font-sans font-semibold text-sm" style="color: var(--text);">{title}</h2>
      <span class="font-sans text-xs italic shrink-0" style="color: var(--muted);">{status}</span>
    </div>
    <p class="text-sm mb-4 flex-1" style="color: var(--muted); font-family: 'Inter', sans-serif; line-height: 1.55;">
      {description}
    </p>
    <div class="flex flex-wrap gap-x-3 gap-y-1 mb-4 font-sans text-xs" style="color: var(--muted);">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-3 font-sans text-xs"
      style="position: relative; z-index: 1; border-top: 1px solid var(--border);"
    >
      {github && <a href={github} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">GitHub</a>}
      {pypi && <a href={pypi} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">PyPI</a>}
      {paper && <a href={paper} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">Paper</a>}
      {demo && <a href={demo} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">Demo</a>}
      {blog && <a href={blog} style="color: var(--accent); text-decoration: none;">Essay →</a>}
    </div>
  </div>
</div>
