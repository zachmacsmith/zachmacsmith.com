---
import Base from '../layouts/Base.astro';
import FeaturedSection from '../components/FeaturedSection.astro';
import { getCollection } from 'astro:content';
import { copy, pageTitle } from '../data/copy';

const essays = await getCollection('essays');
const notes = await getCollection('notes');

function estimateReadTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const allItems = [
  ...essays.map((e) => ({
    title: e.data.title,
    href: `/writing/essays/${e.slug}`,
    type: 'essay' as const,
    date: e.data.date,
  })),
  ...notes.map((n) => ({
    title: n.data.title,
    href: `/writing/notes/${n.slug}`,
    type: 'note' as const,
    date: n.data.date,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);

// Featured items come straight from each piece's own frontmatter (`featured: true`).
// Nothing here is hand-entered, so the home page can never drift from the page it links to.
const featured = [
  ...essays
    .filter((e) => e.data.featured)
    .map((e) => ({
      title: e.data.title,
      href: `/writing/essays/${e.slug}`,
      type: 'essay' as const,
      description: e.data.description,
      date: e.data.date,
      tags: e.data.tags,
      readTime: estimateReadTime(e.body),
    })),
  ...notes
    .filter((n) => n.data.featured)
    .map((n) => ({
      title: n.data.title,
      href: `/writing/notes/${n.slug}`,
      type: 'note' as const,
      description: undefined,
      date: n.data.date,
      tags: n.data.tags,
      readTime: undefined,
    })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Base title={pageTitle(copy.home)}>
  <div class="mx-auto px-6 py-16" style="max-width: 740px;">
      <p class="mb-16" style="font-size: 1.125rem; line-height: 1.8; color: var(--text);">
        {copy.home.intro}
      </p>

      <FeaturedSection items={featured} heading={copy.home.featuredHeading} />

      <section>
        <h2 class="font-sans text-xs uppercase tracking-widest mb-6" style="color: var(--muted); letter-spacing: 0.12em;">
          {copy.home.recentHeading}
        </h2>
        <ul class="flex flex-col">
          {allItems.map((item) => (
            <li class="py-3 flex items-baseline gap-4" style="border-bottom: 1px solid var(--border);">
              <span class="font-sans text-xs italic shrink-0 w-8" style="color: var(--muted);">
                {item.type}
              </span>
              <a
                href={item.href}
                class="font-sans text-sm flex-1 hover:underline"
                style="color: var(--text); text-decoration: none;"
              >
                {item.title}
              </a>
              <span class="font-sans text-xs shrink-0 tabular-nums" style="color: var(--muted);">
                {formatDate(item.date)}
              </span>
            </li>
          ))}
        </ul>
      </section>
  </div>
</Base>
