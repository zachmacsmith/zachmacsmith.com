---
import Base from '../layouts/Base.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import DatedList from '../components/DatedList.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { copy, pageTitle } from '../data/copy';
import { Content as Intro } from '../data/home-intro.md';

const essays = await getCollection('essays');
const notes = await getCollection('notes');

const writing = [
  ...essays.map((e) => ({
    title: e.data.title,
    href: `/writing/essays/${e.slug}`,
    date: e.data.date,
    description: e.data.description,
  })),
  ...notes.map((n) => ({
    title: n.data.title,
    href: `/writing/notes/${n.slug}`,
    date: n.data.date,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

// The home page shows the three newest projects plus any starred ones, in list order.
const featured = projects.filter((p, i) => i < 3 || p.starred);
const hasMore = featured.length < projects.length;
---

<Base title={pageTitle(copy.home)}>
  <div class="col">
    <div class="intro">
      <img class="intro-photo" src="/images/home/lab.jpg" alt="Zach aligning optics on a lab bench" width="900" height="1200" />
      <Intro />
    </div>

    <section class="page-section">
      <h2>{copy.home.projectsHeading}</h2>
      {featured.map((project) => <ProjectEntry {...project} />)}
      {hasMore && <p class="more"><a href="/projects">More projects…</a></p>}
    </section>

    <section class="page-section">
      <h2>{copy.home.writingHeading}</h2>
      <DatedList items={writing} />
    </section>
  </div>
</Base>
