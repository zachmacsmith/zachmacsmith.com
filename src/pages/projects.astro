---
import Base from '../layouts/Base.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { projects } from '../data/projects';
import { copy, pageTitle } from '../data/copy';
---

<Base title={pageTitle(copy.projects)}>
  <div class="col">
    <h1 class="page-title">{copy.projects.heading}</h1>
    <p class="page-subtitle">{copy.projects.subtitle}</p>

    {projects.map((project) => <ProjectEntry {...project} variant="full" />)}
  </div>
</Base>
