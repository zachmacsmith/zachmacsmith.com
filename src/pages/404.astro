---
import Base from '../layouts/Base.astro';
import { copy, pageTitle } from '../data/copy';
---

<Base title={pageTitle(copy.notFound)}>
  <div class="col">
    <p class="muted">{copy.notFound.eyebrow}</p>
    <h1 class="page-title">{copy.notFound.heading}</h1>
    <p class="page-subtitle">{copy.notFound.subtitle}</p>
    <a href="/">{copy.notFound.backLink}</a>
  </div>
</Base>
