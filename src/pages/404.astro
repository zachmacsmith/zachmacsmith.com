---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Zach Macaskill-Smith">
  <div class="mx-auto px-6 py-24" style="max-width: 740px;">
    <p class="font-sans text-xs uppercase tracking-widest mb-6" style="color: var(--muted); letter-spacing: 0.12em;">404</p>
    <h1 class="font-sans font-semibold mb-4" style="font-size: 1.5rem; color: var(--text);">
      Page not found
    </h1>
    <p class="mb-8" style="color: var(--muted); font-size: 1rem; line-height: 1.7;">
      This page doesn't exist or hasn't been written yet.
    </p>
    <a href="/" class="font-sans text-sm" style="color: var(--accent);">← Back to home</a>
  </div>
</Base>
