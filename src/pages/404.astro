---
import Base from '../layouts/Base.astro';
import { copy, pageTitle } from '../data/copy';
---

<Base title={pageTitle(copy.notFound)}>
  <div class="mx-auto px-6 py-24" style="max-width: 740px;">
    <p class="font-sans text-xs uppercase tracking-widest mb-6" style="color: var(--muted); letter-spacing: 0.12em;">{copy.notFound.eyebrow}</p>
    <h1 class="font-sans font-semibold mb-4" style="font-size: 1.5rem; color: var(--text);">
      {copy.notFound.heading}
    </h1>
    <p class="mb-8" style="color: var(--muted); font-size: 1rem; line-height: 1.7;">
      {copy.notFound.subtitle}
    </p>
    <a href="/" class="font-sans text-sm" style="color: var(--accent);">{copy.notFound.backLink}</a>
  </div>
</Base>
