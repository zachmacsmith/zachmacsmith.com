---
import Base from '../../../layouts/Base.astro';
import DatedList from '../../../components/DatedList.astro';
import { getCollection } from 'astro:content';
import { copy, pageTitle } from '../../../data/copy';

const notes = await getCollection('notes');
const items = notes
  .map((n) => ({
    title: n.data.title,
    href: `/writing/notes/${n.slug}`,
    date: n.data.date,
    description: n.data.tags.length > 0 ? n.data.tags.join(', ') : undefined,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base title={pageTitle(copy.notes)}>
  <div class="col">
    <h1 class="page-title">{copy.notes.heading}</h1>
    <p class="page-subtitle">{copy.notes.subtitle}</p>
    <DatedList items={items} />
  </div>
</Base>
