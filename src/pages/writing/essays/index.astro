---
import Base from '../../../layouts/Base.astro';
import DatedList from '../../../components/DatedList.astro';
import { getCollection } from 'astro:content';
import { copy, pageTitle } from '../../../data/copy';

const essays = await getCollection('essays');
const items = essays
  .map((e) => ({
    title: e.data.title,
    href: `/writing/essays/${e.slug}`,
    date: e.data.date,
    description: e.data.description,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base title={pageTitle(copy.essays)}>
  <div class="col">
    <h1 class="page-title">{copy.essays.heading}</h1>
    <p class="page-subtitle">{copy.essays.subtitle}</p>
    <DatedList items={items} />
  </div>
</Base>
