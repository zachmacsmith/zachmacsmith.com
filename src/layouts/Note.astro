---
import Base from './Base.astro';
import { copy } from '../data/copy';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
}

const { title, date, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={`${title} — ${copy.siteName}`} section="notes">
  <article class="mx-auto px-6 py-12" style="max-width: 740px;">
      <header class="mb-8">
        <h1 class="font-sans font-semibold mb-2" style="font-size: 1.5rem; line-height: 1.3; color: var(--text);">
          {title}
        </h1>
        <div class="font-sans text-sm flex flex-wrap items-center gap-2" style="color: var(--muted);">
          <span>{formattedDate}</span>
          <span>·</span>
          <span>working note</span>
          {tags.length > 0 && (
            <>
              <span>·</span>
              <span>{tags.join(', ')}</span>
            </>
          )}
        </div>
      </header>
      <div class="prose-custom">
        <slot />
      </div>
  </article>
</Base>
