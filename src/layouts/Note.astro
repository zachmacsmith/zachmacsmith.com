---
import Base from './Base.astro';
import { copy } from '../data/copy';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  updated?: Date;
  status?: string;
  preview?: boolean;
}

const { title, date, tags = [], description, updated, status, preview } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={`${title} — ${copy.siteName}`} description={description}>
  <article class="col">
    {preview && (
      <p class="preview-banner">Preview: this isn't on the live site. It's marked <code>publish: preview</code> in Obsidian.</p>
    )}
    <header class="article-header">
      <h1>{title}</h1>
      {description && <p class="subtitle">{description}</p>}
      <p class="meta">{[
        formattedDate,
        ...(updated ? [`updated ${updated.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' })}`] : []),
        'note',
        ...(tags.length > 0 ? [tags.join(', ')] : []),
      ].join(' · ')}</p>
      {status && <p class="status">{status}</p>}
    </header>
    <div class="prose-custom">
      <slot />
    </div>
  </article>
</Base>
