---
import Base from './Base.astro';
import { copy } from '../data/copy';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
}

const { title, date, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={`${title} — ${copy.siteName}`}>
  <article class="col">
    <header class="article-header">
      <h1>{title}</h1>
      <p class="meta">{[formattedDate, 'working note', ...(tags.length > 0 ? [tags.join(', ')] : [])].join(' · ')}</p>
    </header>
    <div class="prose-custom">
      <slot />
    </div>
  </article>
</Base>
